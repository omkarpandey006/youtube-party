# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed by CORS + Socket.IO.
# Comma-separated for multiple, e.g. http://localhost:5173,https://your-app.vercel.app
# "*" is rejected in production.
CLIENT_ORIGIN=http://localhost:5173

# --- Socket.IO -------------------------------------------------------------
# Secret used to sign participant identity tokens (HMAC-SHA256).
# REQUIRED in production. Development falls back to an ephemeral secret, which
# means tokens stop working after a restart.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-plus-random-characters

# How long a participant token stays valid (default 12 hours).
PARTICIPANT_TOKEN_TTL_MS=43200000

# Maximum accepted socket message size in bytes.
SOCKET_MAX_BUFFER_BYTES=100000

# --- MongoDB ---------------------------------------------------------------
# Replace username, password and cluster host with the values from
# MongoDB Atlas → Database → Connect → Drivers.
# If the password contains @ : / ? # [ ] %, URL-encode it (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster (created automatically on first write).
MONGODB_DB=youtube_party

# How long the driver waits for a reachable server before failing.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
