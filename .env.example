# =============================================================================
# YouTube Party — Environment Variables Reference
# =============================================================================
# Copy this file to backend/.env for local development or set these variables
# in your deployment platform (e.g. Render, Railway, Fly.io, Heroku, etc.)
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Allowed Frontend Origins (comma-separated if multiple).
# For single-origin deployment (where Express serves frontend build), leave blank
# or set to your deployment URL (e.g. https://your-watchparty.onrender.com).
# For separate hosting (e.g. Vercel frontend + Render backend), set to your Vercel URL.
CLIENT_ORIGIN=https://your-watchparty.onrender.com

# --- Security & Auth ---------------------------------------------------------
# Required in production: 32+ random characters for signing participant tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-secure-random-32-plus-character-secret

# Participant Token Validity in ms (default 12 hours)
PARTICIPANT_TOKEN_TTL_MS=43200000

# Max socket payload buffer in bytes
SOCKET_MAX_BUFFER_BYTES=100000

# --- MongoDB Database --------------------------------------------------------
# MongoDB Atlas Connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=youtube_party

# Timeout configurations (ms)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000

# --- Optional Frontend Build Variables (frontend/.env) -----------------------
# When deploying unified (single-origin), leave these empty:
# VITE_API_BASE_URL=
# VITE_SOCKET_URL=
#
# If frontend is hosted separately on Vercel/Netlify, set them to your backend URL:
# VITE_API_BASE_URL=https://your-backend.onrender.com
# VITE_SOCKET_URL=https://your-backend.onrender.com
