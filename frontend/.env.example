# Base URL of the Express API.
# Leave empty to use the Vite dev proxy (/api -> http://localhost:5000).
VITE_API_BASE_URL=

# Socket.IO backend origin — the Express server, not the Vite dev URL.
# Example: VITE_SOCKET_URL=http://localhost:5000
# Leave empty to use the same origin (Vite proxies /socket.io to the backend).
# Restart `npm run dev` after changing this value.
VITE_SOCKET_URL=
